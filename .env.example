# Copy to .env.local for local development. Never commit real values.
# Variables are added only when a milestone needs them (SPEC 3.4).

# Supabase project (local values come from `pnpm supabase status` once M0.2 is in place)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: admin user creation (M0.5) and the cron fallback (M5). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
