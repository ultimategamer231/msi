# Copy to .env.local for local development. Never commit real values.
# Variables are added only when a milestone needs them (SPEC 3.4).
# Local values: run `pnpm supabase status -o env` after `pnpm db:start`.

# Supabase project. Locally: API_URL and ANON_KEY (or PUBLISHABLE_KEY) from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: admin user creation (M0.5) and the cron fallback (M5). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
