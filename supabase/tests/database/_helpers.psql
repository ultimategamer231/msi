-- Shared helpers for the pgTAP suite, included by every test file with \ir.
-- Everything is created inside the test transaction and rolled back at the end.

create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

-- Mark this database as a test environment (enables the business clock override, B-01).
update public.app_environment set kind = 'test' where id;

-- Creates an auth user plus staff profile and returns its id.
create or replace function tests.create_staff(
  p_name text,
  p_role public.app_role,
  p_branch_code text default null,
  p_active boolean default true
) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, email, aud, role)
  values (v_id, '00000000-0000-0000-0000-000000000000', lower(replace(p_name, ' ', '.')) || '@test.local',
          'authenticated', 'authenticated');
  insert into public.profiles (id, full_name, role, branch_id, active)
  values (v_id, p_name, p_role, (select id from public.branches where code = p_branch_code), p_active);
  return v_id;
end
$$;

-- Creates an auth user without a profile (for admin_set_profile tests).
create or replace function tests.create_login(p_email text) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, email, aud, role)
  values (v_id, '00000000-0000-0000-0000-000000000000', p_email, 'authenticated', 'authenticated');
  return v_id;
end
$$;

-- Switches to a database role with the JWT claims PostgREST would set.
-- p_role: 'authenticated' (needs p_user), 'anon' or 'service_role'.
create or replace function tests.become(p_role text, p_user uuid) returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    case when p_user is null then json_build_object('role', p_role)::text
         else json_build_object('sub', p_user, 'role', p_role)::text end, true);
  perform set_config('role', p_role, true);
end
$$;

create or replace function tests.unbecome() returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end
$$;

-- Runs p_sql as the given role/user. Returns null on success, otherwise the error message.
create or replace function tests.try_as(p_role text, p_user uuid, p_sql text) returns text
language plpgsql
as $$
declare
  v_error text;
begin
  perform tests.become(p_role, p_user);
  begin
    execute p_sql;
  exception when others then
    v_error := sqlerrm;
  end;
  perform tests.unbecome();
  return v_error;
end
$$;

-- Runs a single-value query as the given role/user and returns the value as text.
create or replace function tests.value_as(p_role text, p_user uuid, p_sql text) returns text
language plpgsql
as $$
declare
  v_value text;
begin
  perform tests.become(p_role, p_user);
  execute p_sql into v_value;
  perform tests.unbecome();
  return v_value;
end
$$;

grant usage on schema tests to authenticated, anon, service_role;
grant execute on all functions in schema tests to authenticated, anon, service_role;
